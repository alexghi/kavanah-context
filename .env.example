# Copy to .env (the server loads it at startup). Never commit .env.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=            # only if you were given a custom endpoint

KAVANNAH_OPENROUTER_KEY=

# --- Models: three tiers, each optional beyond the first -------------------------------------
KAVANNAH_MODEL=claude-opus-5-5   # judge tier: classification, evidence verdicts, IHRA review, recommendations, drafts
KAVANNAH_MODEL_FAST=claude-haiku-4-5-20251001   # fast tier: claim extraction + web-search research (unset = judge model)
# KAVANNAH_SEARCH_MODEL=openai/gpt-5.4-mini     # research calls on another backend (an OpenRouter id uses its web plugin)
# KAVANNAH_OPENROUTER_KEY=                      # enables OpenRouter: model ids with "/" run there, and Anthropic
                                                #   rate limits / overloads / timeouts fail over to the same Claude model on OpenRouter
# KAVANNAH_OPENROUTER_FAILOVER=1                # 0 = keep the key for direct routing only, no failover
KAVANNAH_EFFORT=medium           # low | medium | high: reasoning depth of the judge stages (the rest run low)
KAVANNAH_PORT=8787               # PORT (set by Cloud Run and most hosts) is honoured when this is unset
KAVANNAH_MOCK=0                  # 1 = never call the model, serve the built-in demo fixtures
KAVANNAH_WEB_SEARCH=1            # 0 = disable live source retrieval (evidence will be marked unavailable)

# --- Hosting (see docs/DEPLOY.md) ---------------------------------------------------------
# Per-person access keys, "name:key" pairs separated by commas. Managed by `npm run keys`.
# When set, /api/analyze and /api/draft require `Authorization: Bearer <key>` (the extension
# sends the key from Settings → Access key). Required before exposing a live server.
KAVANNAH_ACCESS_KEYS=
# KAVANNAH_HOST=127.0.0.1        # 0.0.0.0 inside a container; the Dockerfile sets it
# KAVANNAH_RATE_LIMIT=30         # live analyses + drafts per key (or per IP) per hour; 0 = unlimited
# KAVANNAH_MAX_CONCURRENT=4      # live analyses in flight at once; 0 = unlimited
# KAVANNAH_TRUST_PROXY=1         # trust X-Forwarded-* (default: on when KAVANNAH_HOST is not loopback)
# KAVANNAH_ALLOW_ANONYMOUS=0     # 1 = allow a live server on a public interface with no keys (don't)
